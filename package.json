{
  "name": "project-name",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "seed2": "ts-node -r tsconfig-paths/register src/seeder.run.ts",
    "build": "nest build",
    "vercel-build": "npm run build && npm run copy-files",
    "copy-files": "cp -r uploads dist/ || true",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "nodemon": "nodemon --ext json,yaml --exec npm run start",
    "start:dev": "set NODE_ENV=development&&nest start --watch",
    "start:dev:debug": "set NODE_ENV=development&&nest start --debug --watch",
    "start:debug": "set NODE_ENV=production&&nest start --debug --watch",
    "start:prod": "set NODE_ENV=production&&node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "typeorm": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js",
    "migration:generate": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:generate -d src/data-source.ts src/migrations/newMigration",
    "migration:run": "node -r ts-node/register -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:run -d src/data-source.ts",
    "migration:revert": "node -r ts-node/register -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:revert -d src/data-source.ts",
    "seed": "ts-node -r tsconfig-paths/register src/seeder.ts"
  },
