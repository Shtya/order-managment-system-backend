    "@bull-board/nestjs": "^9.8.0",
    "@google/genai": "^2.17.1",
    "@nestjs/axios": "^12.0.0",
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/common": "^12.0.0",
